              "expression": "let\n    Raw = Csv.Document(File.Contents(PreparedFolder & \"\\Dim_FunnelStage.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),\n    Typed = Table.TransformColumnTypes(Headers, {{\"Stage\", type text}, {\"Stage Order\", Int64.Type}}, \"en-US\")\nin\n    Typed"
