	partition Fact_OrderItems = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(PreparedFolder & "\Fact_OrderItems.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Order Item ID", Int64.Type}, {"Order ID", Int64.Type}, {"Product ID", Int64.Type}, {"Item Sales Amount", Currency.Type}, {"Item COGS Amount", Currency.Type}, {"Order Date", type date}, {"Customer ID", Int64.Type}, {"Channel ID", Int64.Type}, {"Device", type text}, {"Visitor Type", type text}, {"Landing Page", type text}, {"Item Role", type text}, {"Recorded Refund", Currency.Type}, {"Refunded Item", Int64.Type}, {"Launch Age Month", Int64.Type}}, "en-US")
				in
				    Typed

