				    Raw = Csv.Document(File.Contents(PreparedFolder & "\Dim_Date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"Month", type text}, {"Month Number", Int64.Type}, {"Year-Month", type text}, {"Year Month Sort", Int64.Type}, {"Week", Int64.Type}, {"ISO Year", Int64.Type}, {"Month Start", type date}, {"Day", Int64.Type}, {"Is Complete Sales Month", Int64.Type}, {"Is In Sales Coverage", Int64.Type}}, "en-US")
