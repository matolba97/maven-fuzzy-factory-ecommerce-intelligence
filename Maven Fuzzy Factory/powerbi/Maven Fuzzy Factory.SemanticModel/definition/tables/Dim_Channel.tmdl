	partition Dim_Channel = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(PreparedFolder & "\Dim_Channel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Channel ID", Int64.Type}, {"Traffic Group", type text}, {"Source", type text}, {"Campaign", type text}, {"Ad Content", type text}, {"Referrer", type text}, {"Channel", type text}}, "en-US")
				in
				    Typed

