	partition Dim_Customer = m
		mode: import
		source =
				let
				    Raw = Csv.Document(File.Contents(PreparedFolder & "\Dim_Customer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Customer ID", Int64.Type}, {"First Session Date", type date}, {"First Purchase Date", type date}, {"Purchase Cohort", type text}, {"Observed Lifetime Orders", Int64.Type}, {"Observed Frequency", type text}, {"Customer Status", type text}}, "en-US")
				in
				    Typed

