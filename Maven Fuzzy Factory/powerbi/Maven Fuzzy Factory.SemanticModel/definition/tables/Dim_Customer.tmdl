/// Conformed dimension: Dim_Customer. Disconnected utility only for FunnelStage and CohortAge.
table Dim_Customer
	lineageTag: 5fe805d0-339e-4f6f-ac95-1f9dfbc315ca

	/// Customer ID at Dim_Customer grain. See docs/03-data-dictionary.csv for source lineage and meaning.
	column 'Customer ID'
		dataType: int64
		isHidden
		lineageTag: cc2c3ec4-5334-4266-ba17-547077f43818
		summarizeBy: none
		sourceColumn: Customer ID

	/// First Session Date at Dim_Customer grain. See docs/03-data-dictionary.csv for source lineage and meaning.
	column 'First Session Date'
		dataType: dateTime
		isHidden
		formatString: dd MMM yyyy
		lineageTag: 659ca530-3b83-420e-bec0-3a933ee0d77c
		summarizeBy: none
		sourceColumn: First Session Date

	/// First Purchase Date at Dim_Customer grain. See docs/03-data-dictionary.csv for source lineage and meaning.
	column 'First Purchase Date'
		dataType: dateTime
		isHidden
		formatString: dd MMM yyyy
		lineageTag: a94fd037-a22d-4be8-82b5-06292c0d2e02
		summarizeBy: none
		sourceColumn: First Purchase Date

	/// Purchase Cohort at Dim_Customer grain. See docs/03-data-dictionary.csv for source lineage and meaning.
